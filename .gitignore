# ---- large binaries / build artifacts (regenerable, or pulled from device) ----
backup_clean/
*.apk
*.so
*.i64
*.id0
*.id1
*.id2
*.nam
*.til

# ---- caches / runtime output ----
__pycache__/
*.pyc
reroll_toolkit/wire/
reroll_toolkit/*.log
scratch/*.log
scratch/*_live.log
scratch/create_dump.json
scratch/wire/

# ---- secrets / per-run account data (keep local) ----
auth_new.dat
accounts/
saved_accounts/
*.keystore

# ---- captured traffic dumps (contain live session tokens / auth codes) ----
monitor/exports/
all_flows_clean.json
all_flows.json
exported_flows.json
flows_summary.json
saved_accounts_pre_reset.json
scratch/*.json
*.dat

# ---- debug artifacts: screenshots, memory/state dumps, UI dumps (noise) ----
*.png
*.bin
maps.txt
proc_maps.txt
temp_screen.png
ui_dump.xml
konami_wire/*.bin
reroll_toolkit/konami_wire/

# pure-API tool runtime log
pes_api/daily.log
pes_api/efootbase_cache.json

pes_api/gacha_hits/

injector_app/build/
injector_app/dist/
injector_app/backups/
injector_app/__pycache__/

# server secrets — never commit
server/.env.example
**/.env
